{
  "expo": {
    "name": "เช็กอินกิจกรรม",
    "slug": "campuspass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "campuspass",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.example.campuspass"
    },
    "android": {
      "package": "com.example.campuspass",
      "adaptiveIcon": {
        "backgroundColor": "#ECEBFB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3F3CBB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "เช็กอินกิจกรรม ใช้กล้องถ่ายรูปยืนยันการเข้าร่วมกิจกรรมตอนเช็กอิน",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "เช็กอินกิจกรรม ใช้ตำแหน่งเฉพาะตอนเช็กอิน เพื่อยืนยันว่าคุณอยู่ในพื้นที่จัดกิจกรรม"
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
